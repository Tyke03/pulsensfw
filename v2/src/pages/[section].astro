---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EntityCard from '../components/EntityCard.astro';
import EmptyState from '../components/states/EmptyState.astro';
import NotFound from '../components/states/NotFound.astro';
import StoryCard from '../components/StoryCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryHero } from '../lib/brand/slots';
import { getContentRepository } from '../lib/content/local-repository';
import { entitiesForTopic, presentArticle, risingStars, trendingStars } from '../lib/content/present';
import { readReader } from '../lib/reader/cookies';
import { SITE } from '../lib/site';
import { TOPICS, type TopicId } from '../lib/content/types';

const section = Astro.params.section ?? '';
const known = (TOPICS as readonly string[]).includes(section);
if (!known) Astro.response.status = 404;
const reader = readReader(Astro.cookies, Astro.url.protocol === 'https:');
const repo = getContentRepository();
const topics = await repo.listTopics();
const topic = topics.find((item) => item.id === section);
const articles = await repo.listArticles();
const catalog = await repo.listCatalog();
const filter = Astro.url.searchParams.get('topic');
const matched = articles.filter((article) => article.topic === section && (!filter || article.tags.includes(filter)));
const cards = matched.map((article) => presentArticle(article, reader, catalog));
const entities = topic ? entitiesForTopic(catalog, topic.id, filter, reader) : [];
const rising = topic?.id === 'stars' && !filter ? risingStars(catalog, reader) : [];
const trending = topic?.id === 'stars' && !filter ? trendingStars(catalog, reader) : [];
const [lead, ...rest] = cards;
const entityLabel = topic?.id === 'stars'
  ? 'Profiles'
  : topic?.id === 'sites'
    ? 'Sites'
    : topic?.id === 'ai'
      ? 'Apps'
      : topic?.id === 'toys'
        ? 'Gear'
        : topic?.id === 'vr'
          ? 'Games'
          : '';
---
<BaseLayout title={topic ? `${topic.label} · ${SITE.name}` : `Page not found · ${SITE.name}`} description={topic?.blurb ?? SITE.description} reader={reader} section={known ? (section as TopicId) : undefined} noindex={!known}>
  {topic ? (
    <div class="page" style="padding-bottom:40px">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: topic.label }]} />
      <header class="hub-head">
        <p class="kicker">{topic.short}</p>
        <h1>{topic.label}</h1>
        <p class="dek" style="max-width:52ch">{topic.blurb}</p>
      </header>
      <div class="hub-hero">
        <img src={categoryHero(topic.id)} alt="" />
      </div>
      <div class="filters">
        <a class="c-chip" href={topic.href} aria-current={!filter ? 'page' : undefined}>All</a>
        {topic.subtopics.map((sub) => (
          <a class="c-chip" href={`${topic.href}?topic=${sub.id}`} aria-current={filter === sub.id ? 'page' : undefined}>{sub.label}</a>
        ))}
      </div>
      {rising.length > 0 && (
        <section class="hub-row" aria-labelledby="rising-hub">
          <h2 id="rising-hub">New & rising</h2>
          <div class="scroller profile-scroller" tabindex="0">
            {rising.map((card) => <EntityCard card={card} uid={`hub-rise-${card.id}`} />)}
          </div>
        </section>
      )}
      {trending.length > 0 && (
        <section class="hub-row" aria-labelledby="trend-hub">
          <h2 id="trend-hub">Trending</h2>
          <div class="scroller profile-scroller" tabindex="0">
            {trending.map((card) => <EntityCard card={card} uid={`hub-trend-${card.id}`} />)}
          </div>
        </section>
      )}
      {entities.length > 0 && (
        <section class="hub-row" aria-labelledby="entity-hub">
          <h2 id="entity-hub">{filter ? topic.subtopics.find((sub) => sub.id === filter)?.label ?? entityLabel : entityLabel}</h2>
          <div class="profile-grid">
            {entities.map((card) => <EntityCard card={card} uid={`hub-ent-${card.id}`} />)}
          </div>
        </section>
      )}
      {cards.length === 0 && entities.length === 0 ? (
        <EmptyState title="Nothing in this slice yet" body="The example desk does not have a story or a profile under that filter. Try the full hub.">
          <a class="c-btn c-btn--primary" href={topic.href}>Clear filter</a>
        </EmptyState>
      ) : cards.length > 0 && (
        <section class="hub-row" aria-labelledby="stories-hub">
          <h2 id="stories-hub">From the desk</h2>
          <div class="story-grid">
            {lead && <StoryCard card={lead} layout="feature" uid={`hub-${lead.slug}`} heading="h2" />}
            <div class="rest">
              {rest.map((card) => <StoryCard card={card} layout="text" uid={`hub-rest-${card.slug}`} />)}
            </div>
          </div>
        </section>
      )}
    </div>
  ) : (
    <NotFound articles={articles} reader={reader} />
  )}
</BaseLayout>
