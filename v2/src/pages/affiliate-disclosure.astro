---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { readReader } from '../lib/reader/cookies';
import { SITE } from '../lib/site';
const reader = readReader(Astro.cookies, Astro.url.protocol === 'https:');
---
<BaseLayout title={`Affiliate disclosure · ${SITE.name}`} description="How affiliate links will be labeled when they exist." reader={reader}>
  <article class="page" style="padding-bottom:48px">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Affiliate disclosure' }]} />
    <p class="kicker">Disclosure</p>
    <h1>Affiliate disclosure</h1>
    <div class="prose">
      <p>Phase 1 has no affiliate links and no merchant checkout. Deal cards are example prices.</p>
      <p>When a link can pay the desk, the line on it will read: Affiliate link—if you choose to try it, PulseNSFW may earn a commission at no extra cost to you. Straight news does not carry that link. A story gets at most one.</p>
    </div>
  </article>
</BaseLayout>
