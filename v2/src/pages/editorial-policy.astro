---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { readReader } from '../lib/reader/cookies';
import { SITE } from '../lib/site';
const reader = readReader(Astro.cookies, Astro.url.protocol === 'https:');
---
<BaseLayout title={`Editorial policy · ${SITE.name}`} description="What PulseNSFW covers, and what it leaves out." reader={reader}>
  <article class="page" style="padding-bottom:48px">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Editorial policy' }]} />
    <p class="kicker">Policy</p>
    <h1>Editorial policy</h1>
    <div class="prose">
      <p>Pulse covers news, guides, reviews, and rankings across AI companions, sex tech, VR, adult creators, and the wider NSFW web. The reader is an adult who wants to know what changed and whether a product is worth the trouble.</p>
      <p>Industry news has to matter to a viewer or a creator. A filing, a rumor, or a leak is not a story. Exploitation, nonconsensual material, and harassment are out of scope.</p>
      <p>Phase 1 copy is labeled example. When publishing starts, drafts stay drafts until a QC pass. The publishing keys for that desk never ship to the browser.</p>
    </div>
  </article>
</BaseLayout>
