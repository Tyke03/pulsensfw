---
import BaseLayout from '../layouts/BaseLayout.astro';
import ReaderPanel from '../components/reader/ReaderPanel.astro';
import { readReader } from '../lib/reader/cookies';
import { SITE, noticeCopy } from '../lib/site';
import { getServerSession, neonAuthConfigured, type SessionRow } from '../lib/auth/neon';
import {
  getReaderProfile,
  listReaderSaved,
  listReaderFollows,
  upsertReaderProfile,
} from '../lib/auth/reader-store';
import { requireNeon } from '../lib/db/pg';
import { ENTITY_LABEL, findEntityBySlug } from '../lib/content/entities';
import { getContentRepository } from '../lib/content/local-repository';
import type { Catalog } from '../lib/content/types';

const reader = readReader(Astro.cookies, Astro.url.protocol === 'https:');
const notice = Astro.url.searchParams.get('notice');
const copy = noticeCopy(notice);
const authConfigured = neonAuthConfigured();

let session: SessionRow | null = null;
if (authConfigured) session = await getServerSession(Astro.request.headers);

const repo = getContentRepository();
const catalog: Catalog = await repo.listCatalog();

let profile: { nsfwPref: boolean; createdAt: string; updatedAt: string } | null = null;
let saved: Array<{ slug: string; kind: string; created_at: string }> = [];
let follows: Array<{ slug: string; kind: string; created_at: string }> = [];
if (session) {
  try {
    const runner = await requireNeon();
    const existing = await getReaderProfile(runner, session.userId);
    if (existing) {
      profile = {
        nsfwPref: Boolean(existing.nsfw_pref),
        createdAt: String(existing.created_at ?? ''),
        updatedAt: String(existing.updated_at ?? ''),
      };
    } else {
      // First sign-in: seed the profile from the browser's cookie choice so
      // the account starts where the reader already was.
      await upsertReaderProfile(runner, session.userId, reader.nsfw);
      profile = { nsfwPref: reader.nsfw, createdAt: '', updatedAt: '' };
    }
    saved = await listReaderSaved(runner, session.userId);
    follows = await listReaderFollows(runner, session.userId);
  } catch {
    profile = null;
  }
}

type ListRow = { slug: string; kind: 'star' | 'site' | 'ai' | 'product' | 'game'; created_at: string };

const KIND_ROUTES: Record<ListRow['kind'], string> = {
  star: '/stars/',
  site: '/sites/',
  ai: '/ai/',
  product: '/products/',
  game: '/games/',
};

function asRows(list: Array<{ slug: string; kind: string; created_at: string }>): ListRow[] {
  const out: ListRow[] = [];
  for (const row of list) {
    if (row.kind in KIND_ROUTES) out.push({ slug: row.slug, kind: row.kind as ListRow['kind'], created_at: row.created_at });
  }
  return out;
}

const savedRows = asRows(saved);
const followRows = asRows(follows);

function nameOf(row: ListRow): string {
  return findEntityBySlug(catalog, row.slug)?.name ?? row.slug;
}

function isLive(row: ListRow): boolean {
  return findEntityBySlug(catalog, row.slug) !== null;
}

function kindLabel(row: ListRow): string {
  const entity = findEntityBySlug(catalog, row.slug);
  return entity ? ENTITY_LABEL[entity.type] : 'no longer tracked';
}

function hrefOf(row: ListRow): string {
  const entity = findEntityBySlug(catalog, row.slug);
  return entity ? `${KIND_ROUTES[row.kind]}${entity.slug}` : '#';
}
---
<BaseLayout title={`Your desk · ${SITE.name}`} reader={reader} noindex>
  <div class="page" style="padding:24px 0 48px;max-width:720px">
    <p class="kicker">You</p>

    {session ? (
      <Fragment>
        <h1>Your desk</h1>
        <p class="dek">
          Signed in as <strong>{session.email ?? 'reader'}</strong>. The age gate and these switches
          stay in this browser as the fast path; saves and follows travel with the account.
        </p>
        {profile && (
          <p class="meta">
            NSFW preference on profile: {profile.nsfwPref ? 'on' : 'off'}
            {profile.createdAt ?
            ` · member since ${profile.createdAt.slice(0, 10)}` : ''}
          </p>
        )}
        <ReaderPanel reader={reader} returnTo="/you" />
        <section class="you-block">
          <h2>Saved</h2>
          {savedRows.length === 0 && <p class="meta">Nothing saved yet. Open any review and hit Save.</p>}
          {savedRows.length > 0 && (
            <ul class="plain-list you-list">
              {savedRows.map((row) => (
                <li>
                  {isLive(row)
                    ? <a href={hrefOf(row)}>{nameOf(row)}</a>
                    : <span>{nameOf(row)}</span>}
                  <span class="meta you-kind">{kindLabel(row)}</span>
                  <form method="post" action="/api/reader/save" data-astro-reload>
                    <input type="hidden" name="slug" value={row.slug} />
                    <input type="hidden" name="kind" value={row.kind} />
                    <input type="hidden" name="on" value="0" />
                    <input type="hidden" name="return" value="/you" />
                    <button class="c-btn c-btn--ghost" type="submit">Unsave</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
        <section class="you-block">
          <h2>Following</h2>
          {followRows.length === 0 && <p class="meta">No follows yet. Follow a star, site, or AI app you would check again.</p>}
          {followRows.length > 0 && (
            <ul class="plain-list you-list">
              {followRows.map((row) => (
                <li>
                  {isLive(row)
                    ? <a href={hrefOf(row)}>{nameOf(row)}</a>
                    : <span>{nameOf(row)}</span>}
                  <span class="meta you-kind">{kindLabel(row)}</span>
                  <form method="post" action="/api/reader/follow" data-astro-reload>
                    <input type="hidden" name="slug" value={row.slug} />
                    <input type="hidden" name="kind" value={row.kind} />
                    <input type="hidden" name="on" value="0" />
                    <input type="hidden" name="return" value="/you" />
                    <button class="c-btn c-btn--ghost" type="submit">Unfollow</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
        <section class="you-block">
          <h2>Account</h2>
          <form method="post" action="/api/auth/adapter-sign-out" data-astro-reload>
            <input type="hidden" name="return" value="/you" />
            <button class="c-btn c-btn--secondary" type="submit">Sign out</button>
          </form>
          <p class="meta">Signing out keeps the age gate and reader switches on this browser.</p>
        </section>
      </Fragment>
    ) : (
      <Fragment>
        <h1>Reader settings</h1>
        <p class="dek">
          You are browsing as a guest. Discreet mode, blur, and the age gate stay in this browser.
          Sign in to carry saved pages and follows across devices — email and password, issued by
          the desk's Neon Auth service.
        </p>
        <ReaderPanel reader={reader} returnTo="/you" />
        {authConfigured ? (
          <section class="you-block">
            <h2>Sign in</h2>
            <form method="post" action="/api/auth/adapter-sign-in" class="stack" data-astro-reload>
              <input type="hidden" name="return" value="/you" />
              <label class="c-field" for="auth-email">Email</label>
              <input class="c-input" id="auth-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
              <label class="c-field" for="auth-password">Password</label>
              <input class="c-input" id="auth-password" name="password" type="password" autocomplete="current-password" required minlength="8" placeholder="at least 8 characters" />
              <div class="submit-row">
                <button class="c-btn c-btn--primary" type="submit">Sign in</button>
              </div>
            </form>
            <h2>New here</h2>
            <form method="post" action="/api/auth/adapter-sign-up" class="stack" data-astro-reload>
              <input type="hidden" name="return" value="/you" />
              <label class="c-field" for="signup-name">Name or handle</label>
              <input class="c-input" id="signup-name" name="name" type="text" autocomplete="name" required maxlength="80" placeholder="Reader" />
              <label class="c-field" for="signup-email">Email</label>
              <input class="c-input" id="signup-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
              <label class="c-field" for="signup-password">Password</label>
              <input class="c-input" id="signup-password" name="password" type="password" autocomplete="new-password" required minlength="8" placeholder="at least 8 characters" />
              <div class="submit-row">
                <button class="c-btn c-btn--secondary" type="submit">Create the account</button>
              </div>
            </form>
            <p class="meta">
              Sessions are verified on this server on every request. We never ask for a card or an ID
              here; the managed Better Auth service (Neon Auth) stores the session.
            </p>
          </section>
        ) : (
          <section class="you-block">
            <h2>Accounts are not wired up here</h2>
            <p class="meta">
              Neon Auth is not enabled on this deployment yet (NEON_AUTH_BASE_URL +
              NEON_AUTH_COOKIE_SECRET unset, or the Better Auth service not enabled in the Neon
              console). Everything on this page still works through this browser.
            </p>
          </section>
        )}
      </Fragment>
    )}
    {copy && <p class="meta notice-line session-notice">{copy}</p>}
  </div>
</BaseLayout>
