---
import BaseLayout from '../layouts/BaseLayout.astro';
import DealCard from '../components/DealCard.astro';
import EntityCard from '../components/EntityCard.astro';
import Icon from '../components/Icon.astro';
import NewsletterStrip from '../components/NewsletterStrip.astro';
import MediaFrame from '../components/MediaFrame.astro';
import PulseRule from '../components/PulseRule.astro';
import ScoreBadge from '../components/ScoreBadge.astro';
import StoryCard from '../components/StoryCard.astro';
import { assembleHome } from '../lib/content/assemble';
import { getContentRepository } from '../lib/content/local-repository';
import { readReader } from '../lib/reader/cookies';
import { RAIL_META, SEARCH_FILTERS, SITE, TOPIC_LABEL } from '../lib/site';
import type { ArticleCard, RailId } from '../lib/content/types';

const reader = readReader(Astro.cookies, Astro.url.protocol === 'https:');
const repo = getContentRepository();
const home = assembleHome(
  await repo.listArticles(),
  await repo.listTopics(),
  await repo.listDeals(),
  await repo.listCatalog(),
  reader,
);
const lead = home.lead;
const rails: Array<{ id: RailId; layout: 'feature' | 'text' | 'editor' | 'guide' | 'rank' }> = [
  { id: 'trending', layout: 'feature' },
  { id: 'latest', layout: 'text' },
  { id: 'editors', layout: 'editor' },
  { id: 'guides', layout: 'guide' },
  { id: 'top10', layout: 'rank' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: Astro.site?.href ?? Astro.url.origin,
  description: SITE.description,
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL('/search?q={search_term_string}', Astro.site ?? Astro.url.origin).href,
    'query-input': 'required name=search_term_string',
  },
};
---
<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description} reader={reader}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="home-search-band" aria-labelledby="home-search-title">
    <div class="page">
      <p class="kicker">{SITE.tagline}</p>
      <h2 id="home-search-title">Find it before the tab binge.</h2>
      <p class="dek">Stars, sites, AI, toys, VR, and the stories on this desk. One index, one search, fewer tabs.</p>
      <form class="home-search" action="/search" method="get" data-astro-reload>
        <label class="sr-only" for="home-q">Search</label>
        <input class="c-input" id="home-q" name="q" type="search" placeholder="Angela White, CrushOn, Pornhub, VR…" />
        <button class="c-btn c-btn--primary" type="submit">Search</button>
      </form>
      <div class="search-types">
        {SEARCH_FILTERS.map((filter) => (
          <a class="c-chip" href={`/search?type=${filter.id}`}>{filter.label}</a>
        ))}
      </div>
    </div>
  </section>

  <div class="hero-band">
  <div class="page hero">
    <article class="hero-lead">
      {lead.media.state === 'withheld' ? (
        <MediaFrame media={lead.media} topic={lead.topic} uid={`lead-${lead.slug}`} />
      ) : (
        <a class="hero-media" href={lead.href} aria-label={lead.title}>
          <MediaFrame media={lead.media} topic={lead.topic} uid={`lead-${lead.slug}`} />
        </a>
      )}
      <div class="hero-copy">
        <p class="kicker">{lead.kicker} · {TOPIC_LABEL[lead.topic]}</p>
        <h1><a href={lead.href}>{lead.title}</a></h1>
        <p class="dek">{lead.dek}</p>
        <p class="card-meta">
          {lead.badges.map((badge) => <span class:list={['c-badge', `c-badge--${badge}`]}>{badge}</span>)}
          {lead.score !== null && <ScoreBadge score={lead.score} />}
          <span class="meta">{lead.author} · {lead.publishedLabel} · {lead.readingMinutes} min</span>
        </p>
      </div>
    </article>
    <div class="hero-stack">
      {home.stack.map((card) => <StoryCard card={card} layout="stack" uid={`stack-${card.slug}`} heading="h2" />)}
    </div>
  </div>
  </div>

  <div class="page">
    <ul class="desk">
      {home.desk.map((card: ArticleCard) => (
        <li>
          <a href={card.href}>
            <span class:list={['c-chip', `c-chip--${card.topic}`]}>{TOPIC_LABEL[card.topic]}</span>
            <span>{card.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <section class="band" aria-labelledby="rising-title">
    <div class="rail-head">
      <div>
        <p class="kicker">People on the desk</p>
        <h2 id="rising-title">Star profiles</h2>
      </div>
      <PulseRule />
      <a class="see-all" href="/stars">Stars &amp; Creators</a>
    </div>
    <div class="scroller-bleed">
      <div class="scroller profile-scroller" id="rail-rising" data-carousel tabindex="0">
        {home.trendingStars.map((card) => <EntityCard card={card} uid={`rise-${card.id}`} />)}
      </div>
    </div>
  </section>

  <section class="band band--raised" aria-labelledby="sites-title">
    <div class="rail-head">
      <div>
        <p class="kicker">Premium, tubes, cams, niches</p>
        <h2 id="sites-title">Sites to open</h2>
      </div>
      <a class="see-all" href="/sites">All sites</a>
    </div>
    <div class="scroller-bleed">
      <div class="scroller profile-scroller" id="rail-sites" data-carousel tabindex="0">
        {home.sites.map((card) => <EntityCard card={card} uid={`site-${card.id}`} />)}
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="hubs-title">
    <div class="section-head">
      <h2 id="hubs-title">Sections</h2>
      <PulseRule />
      <a class="see-all" href="/hubs">See all</a>
    </div>
    <div class="page bento">
      {home.topics.map((topic) => (
        <a class="topic-tile" href={topic.href} style={`--tile: var(--${topic.id})`}>
          <span class="kicker">{topic.subtopics.length} desks</span>
          <strong>{topic.label}</strong>
          <span>{topic.blurb}</span>
        </a>
      ))}
    </div>
  </section>

  {rails.map((rail, index) => (
    <section class:list={['band', index % 2 === 1 && 'band--raised']} aria-labelledby={`${rail.id}-title`}>
      <div class="rail-head">
        <div>
          <p class="kicker">{RAIL_META[rail.id].lede}</p>
          <h2 id={`${rail.id}-title`}>{RAIL_META[rail.id].title}</h2>
        </div>
        <PulseRule />
        <div class="rail-actions">
          <button class="icon-btn carousel-btn" type="button" data-carousel-prev data-carousel-target={`rail-${rail.id}`} aria-label={`Scroll ${RAIL_META[rail.id].title} backward`}>
            <Icon name="chevron" />
          </button>
          <button class="icon-btn carousel-btn" type="button" data-carousel-next data-carousel-target={`rail-${rail.id}`} aria-label={`Scroll ${RAIL_META[rail.id].title} forward`} style="transform:scaleX(-1)">
            <Icon name="chevron" />
          </button>
          <a class="see-all" href={RAIL_META[rail.id].href}>See all</a>
        </div>
      </div>
      <div class="scroller-bleed">
        <div class="scroller" id={`rail-${rail.id}`} data-carousel tabindex="0">
          {home.rails[rail.id].map((card, cardIndex) => (
            <StoryCard
              card={card}
              uid={`${rail.id}-${card.slug}`}
              layout={rail.layout === 'feature' && cardIndex > 0 ? 'standard' : rail.layout}
              rank={cardIndex + 1}
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  {home.deals.length > 0 && (
    <section class="band" aria-labelledby="deals-title">
      <div class="rail-head">
        <div>
          <p class="kicker">Deals</p>
          <h2 id="deals-title">Deals</h2>
        </div>
        <a class="see-all" href="/deals">See all</a>
      </div>
      <div class="scroller-bleed">
        <div class="scroller" id="rail-deals" data-carousel tabindex="0">
          {home.deals.map((deal) => <DealCard deal={deal} uid={`deal-${deal.id}`} />)}
        </div>
      </div>
    </section>
  )}

  <NewsletterStrip />
</BaseLayout>
