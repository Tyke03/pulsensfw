---
import EntityCard from '../EntityCard.astro';
import EntityDataPanel from '../EntityDataPanel.astro';
import SourceList from './SourceList.astro';
import type { TemplateEntity } from '../../lib/content/templates';
import type { ArticlePage } from '../../lib/content/types';

interface Props {
  article: ArticlePage;
  entities: TemplateEntity[];
}
const { article, entities } = Astro.props;
const isNews = article.kind === 'news';
---
<div class:list={['template', isNews ? 'template--news' : 'template--guide']}>
  <div class="template-lede">
    <p class="kicker">
      {isNews ? 'News desk' : 'Guide'}{article.checkedLabel ? ` · facts checked ${article.checkedLabel}` : ''}
    </p>
    <p class="dek">
      {isNews
        ? 'Timestamped record of what changed. Entity facts below update from their own files.'
        : 'Written for the moment you have to decide. Entity records below stay synced with their files.'}
    </p>
  </div>

  <div class="prose"><slot /></div>

  {entities.length > 0 && (
    <section class="hub-row" aria-labelledby="story-entities">
      <h2 id="story-entities">{isNews ? 'Entities named in this update' : 'Records in this guide'}</h2>
      {entities.length > 1 && (
        <p class="tag-row guide-anchor-chips">
          {entities.map((item) => (
            <a class="c-chip" href={`#guide-${article.slug}-${item.slug}`}>{item.title}</a>
          ))}
        </p>
      )}
      <div class="profile-grid">
        {entities.map((item) => <EntityCard card={item} uid={`guide-${article.slug}-${item.slug}`} />)}
      </div>
      <div class="stacked-panels">
        {entities.map((item) => (
          <EntityDataPanel
            entity={item.entity}
            media={item.media}
            topic={item.topic}
            uid={`guide-panel-${article.slug}-${item.slug}`}
            anchor={`guide-${article.slug}-${item.slug}`}
            compact
          />
        ))}
      </div>
    </section>
  )}

  <SourceList sources={article.sources} />
</div>

<style>
  .stacked-panels { display: grid; gap: 16px; margin-top: 16px; }
  .guide-anchor-chips { margin: 0 0 8px; }
</style>
