---
import StarProfile from '../StarProfile.astro';
import SourceList from './SourceList.astro';
import type { TemplateEntity } from '../../lib/content/templates';
import type { ArticlePage } from '../../lib/content/types';

interface Props {
  article: ArticlePage;
  entities: TemplateEntity[];
}
const { article, entities } = Astro.props;
const star = entities[0];
---
<div class="template template--star">
  <div class="template-lede">
    <p class="kicker">
      Star profile{article.checkedLabel ? ` · facts checked ${article.checkedLabel}` : ''}
    </p>
    <p class="dek">One record per subject. The chips, dates, and sources below update from the entity file, not from this page.</p>
  </div>
  {star && (
    <StarProfile
      entity={star.entity}
      media={star.media}
      topic={star.topic}
      uid={`star-${article.slug}`}
    />
  )}
  <div class="prose"><slot /></div>
  <SourceList sources={[...article.sources, ...(star ? star.entity.facts.map((fact) => ({ label: `${fact.key}: ${fact.value}`, url: fact.source_url, checked: fact.checked })) : [])]} />
</div>
