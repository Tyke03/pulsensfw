---
import MediaFrame from './MediaFrame.astro';
import type { CharacterCard, GalleryCard, TopicId } from '../lib/content/types';

interface Props {
  item: CharacterCard | GalleryCard;
  kind: 'cast' | 'gallery';
  uid: string;
}
const { item, kind, uid } = Astro.props;
const topic: TopicId = kind === 'cast' ? 'ai-chat' : 'creators';
const title = 'name' in item ? item.name : item.title;
const line = 'line' in item ? item.line : 'Placeholder plate';
---
<article class={kind === 'cast' ? 'cast-card' : 'gallery-card'}>
  <MediaFrame media={item.media} topic={topic} uid={uid} />
  <a href={item.href} target="_blank" rel="noopener noreferrer">
    <strong>{title}</strong><br />
    <span class="meta">{line} · example</span>
  </a>
</article>
