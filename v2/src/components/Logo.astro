---
interface Props {
  discreet?: boolean;
  markId?: string;
}
const { discreet = false, markId = 'logo' } = Astro.props;
const gloss = `${markId}-gloss`;
const shine = `${markId}-shine`;
---
<a class="logo" href="/" data-pulse aria-label={discreet ? 'Home' : 'PulseNSFW home'}>
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id={gloss} x1="6" y1="2" x2="28" y2="30">
        <stop offset="0" stop-color="#ff4f9a" />
        <stop offset="0.52" stop-color="#8d4dff" />
        <stop offset="1" stop-color="#5cf2ee" />
      </linearGradient>
      <linearGradient id={shine} x1="8" y1="4" x2="20" y2="14">
        <stop offset="0" stop-color="#ffffff" stop-opacity="0.75" />
        <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="8" fill="#140c1c" />
    <rect x="0.75" y="0.75" width="30.5" height="30.5" rx="7.4" fill="none" stroke={`url(#${gloss})`} stroke-opacity="0.55" />
    <path fill={`url(#${gloss})`} d="M9.2 25.2V6.8h7.6c4.15 0 6.7 2.35 6.7 5.85 0 3.4-2.5 5.75-6.55 5.75H13v6.8H9.2zm3.8-10.05h3.35c2.15 0 3.35-.95 3.35-2.4s-1.2-2.35-3.35-2.35H13v4.75z" />
    <path d="M14.15 12.65h1.9l.7-1.35.95 2.55.65-1.2h2" fill="none" stroke="#140c1c" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M10.2 7.6h8" fill="none" stroke={`url(#${shine})`} stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <span class="logo-type">
    <span class="logo-word">{discreet ? 'Notes' : 'PULSE'}</span>
    <svg class="logo-line" viewBox="0 0 88 12" aria-hidden="true">
      <path d="M1 7 H28 L34 7 L38 2 L44 11 L48 4 L52 7 H87" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="logo-sub" hidden={discreet}>NSFW</span>
  </span>
</a>
